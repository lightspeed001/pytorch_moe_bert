graph TD
    subgraph "K3s Architecture"
        A1[Bare Metal/VMs] --> B1[K3s Control Plane]
        B1 --> C1[Worker Nodes]
        C1 --> D1[Model Pods]
        D1 --> E1[MetalLB]
        E1 --> F1[Traefik Ingress]
        F1 --> G1[External Traffic]
    end

    subgraph "GKE Architecture"
        A2[GCP Cloud] --> B2[GKE Control Plane]
        B2 --> C2[Node Pools]
        C2 --> D2[Model Pods]
        D2 --> E2[GCP Load Balancer]
        E2 --> F2[Ingress Controller]
        F2 --> G2[External Traffic]
    end

    style A1 fill:#f9f,stroke:#333
    style A2 fill:#bbf,stroke:#333
